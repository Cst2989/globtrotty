# Anthropic API key. Needed by `npm run trip` and by RECORD_MODEL=1 test runs only.
ANTHROPIC_API_KEY=

# Only for identity-linked Console keys, which the API refuses without a workspace. Find it under Settings, Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Postgres for the course branch. A free Supabase project works: create one at
# supabase.com, open Project settings, Database, and copy the direct connection
# string (port 5432). Tests that need a database skip cleanly when this is unset.
DATABASE_URL=

# Anthropic API key. Needed by `npm run trip` and by RECORD_MODEL=1 test runs only.
ANTHROPIC_API_KEY=

# Only for identity-linked Console keys, which the API refuses without a workspace. Find it under Settings, Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Postgres for the course branch. A free Supabase project works: create one at
# supabase.com, open Project settings, Database, and copy the direct connection
# string (port 5432). Tests that need a database skip cleanly when this is unset.
DATABASE_URL=

# SearchApi.io key, for live Google Hotels results. Optional: without it,
# `npm run trip` uses the mock supplier for hotels and prints that it did, and
# `LIVE_SUPPLIERS=1 npm test` skips the SearchApi live file's assertions. Kiwi
# needs no key at all, so live flights work without this.
GOOGLE_SEARCH_API=

# Shared between the process that starts a turn and the background function that
# runs it. Any long random string: `openssl rand -hex 32`.
WORKER_SHARED_SECRET=
# Where the background function reaches itself. http://localhost:8888 locally.
SITE_URL=
